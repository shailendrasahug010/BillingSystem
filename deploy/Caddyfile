# Serves the web app and proxies /api to the API container on the same origin,
# so the refresh-token cookie stays first-party (SameSite=Strict) and no CORS
# is needed in production. Caddy obtains TLS certificates automatically.
{$DOMAIN:localhost} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		# The service worker and manifest must be re-checked on every start, so an update is seen at once.
		header /sw.js Cache-Control "no-cache"
		header /manifest.webmanifest Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# The camera scans barcodes and the microphone takes voice search (it was off, so voice search failed here).
		Permissions-Policy "camera=(self), microphone=(self), geolocation=(self)"
		# Scripts only from this site (WEB_APP_CSP in packages/core/src/security/csp.ts; the API's tests check they match).
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' data: blob:; media-src 'self' data: blob:; worker-src 'self' blob:; frame-src 'self' blob:; object-src 'self' blob:; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
		-Server
	}
}
