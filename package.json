{
  "name": "digitalbahi",
  "private": true,
  "license": "UNLICENSED",
  "description": "Distributor & Supplier CRM, Inventory, Billing and GST platform for Indian distributors and wholesalers",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @digitalbahi/web build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "eslint . --max-warnings 0",
    "lint:i18n": "pnpm --filter @digitalbahi/i18n test",
    "db:generate": "pnpm --filter @digitalbahi/db generate",
    "db:verify": "pnpm --filter @digitalbahi/db verify",
    "db:docs": "pnpm --filter @digitalbahi/db reference",
    "dev:web": "pnpm --filter @digitalbahi/web dev",
    "preview:web": "pnpm --filter @digitalbahi/web preview",
    "db:migrate": "pnpm --filter @digitalbahi/db migrate",
    "dev:api": "pnpm --filter @digitalbahi/api dev",
    "db:deploy": "pnpm --filter @digitalbahi/api deploy:db"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.1"
  }
}
