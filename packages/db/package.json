{
  "name": "@vyapaar/db",
  "version": "0.1.0",
  "private": true,
  "description": "PostgreSQL schema (Drizzle ORM), SQL migrations and reference-data seeds.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "verify": "vitest run --reporter=verbose",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "setup-app-role": "tsx scripts/setup-app-role.ts"
  },
  "dependencies": {
    "@vyapaar/core": "workspace:*",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
