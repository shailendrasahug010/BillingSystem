{
  "name": "@vyapaar/api",
  "version": "0.1.0",
  "private": true,
  "description": "REST API (Fastify): one modular monolith serving the web, Windows and Android apps.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "keys": "tsx scripts/generate-keys.ts",
    "deploy:db": "tsx src/deploy.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.9.0",
    "@fastify/swagger-ui": "6.1.1",
    "@node-rs/argon2": "2.2.1",
    "@vyapaar/contracts": "workspace:*",
    "@vyapaar/core": "workspace:*",
    "@vyapaar/db": "workspace:*",
    "@vyapaar/i18n": "workspace:*",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "jose": "6.2.12",
    "nodemailer": "^10.0.10",
    "pdfkit": "0.20.2",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "uuidv7": "1.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "openapi-types": "12.1.3",
    "pdfjs-dist": "6.3.289",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
