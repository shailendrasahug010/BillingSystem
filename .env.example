# Copy to .env (git-ignored) and fill in. Never commit real values.

# Public host name; Caddy fetches a TLS certificate for it.
DOMAIN=localhost

# Schema owner (migrations only) and the API's restricted role.
POSTGRES_PASSWORD=change-me-owner
APP_DB_PASSWORD=change-me-app

# A server installed before the rename to Digital Bahi (when the project was called
# "vyapaar"): uncomment these four lines so it keeps its database volume, database
# and roles. New servers leave them commented (digitalbahi, digitalbahi_owner,
# digitalbahi_app).
# COMPOSE_PROJECT_NAME=vyapaar
# POSTGRES_USER=vyapaar_owner
# POSTGRES_DB=vyapaar
# APP_DB_ROLE=vyapaar_app

# Access-token signing keys (Ed25519). Generate with:
#   pnpm --filter @digitalbahi/api keys
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Encrypts bank account numbers at rest (printed by the same command). Back it up:
# data encrypted with a lost key cannot be recovered.
DATA_ENCRYPTION_KEY=

# SMS / WhatsApp gateway adapter that delivers OTPs: receives POST {mobile, code, purpose}.
OTP_WEBHOOK_URL=
OTP_WEBHOOK_TOKEN=

# Optional: the platform's mail server for firms that do not set up their own SMTP
# (Settings -> WhatsApp & email). Each firm's WhatsApp Business number is set up in the app.
SMTP_URL=
MAIL_FROM=
